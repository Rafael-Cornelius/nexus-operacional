NODE_ENV=development
APP_NAME="NEXUS OPERACIONAL"
WEB_PORT=3000
# Porta da API quando executada diretamente, fora do Docker Compose.
API_PORT=3333
# Porta loopback publicada pelo Compose; a porta interna permanece 3333.
API_HOST_PORT=3333
POSTGRES_USER=nexus
# Obrigatoria no Docker Compose. Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_operacional
POSTGRES_PORT=5432
# Obrigatoria no Compose; em producao use somente a origem HTTPS publica, sem caminho.
WEB_ORIGIN=
API_URL=http://localhost:3333
# Gravadas no build do frontend Docker; alteracoes exigem rebuild da imagem web.
NEXT_PUBLIC_API_URL=/api
# Credenciais publicas exclusivas do preview; nunca reutilize credenciais operacionais.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@demo.nexus.local
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="NexusDemo@2026"

# Para execucao local sem Docker, informe a mesma senha do PostgreSQL na URL.
DATABASE_URL=
# Obrigatoria em producao. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL="15m"
AUTH_COOKIE_SAMESITE="lax"

# Execucao direta fora do Compose. No Compose, use .env.bootstrap separado.
# Use email real e senha exclusiva; nunca copie credencial do preview.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Administrador Nexus"
# Depois do primeiro seed, apague INITIAL_ADMIN_PASSWORD. Só preencha novamente
# para rotacao intencional com true; incrementa sessionVersion e revoga sessoes.
INITIAL_ADMIN_ROTATE_PASSWORD=false
# Opcional. Vazio nao cria configuracao ficticia.
COMPANY_NAME=
LEGACY_EXCEL_PATH=
# Execucao direta fora do Compose; no container o volume usa /app/uploads/imports.
IMPORT_UPLOAD_DIR="./uploads/imports"
IMPORT_MAX_UPLOAD_BYTES=26214400
# Execucao direta fora do Compose; no container o volume usa /app/backups.
BACKUP_DIR="./backups"
# Docker Compose: diretorio existente e gravavel no host, fora do volume primario.
BACKUP_EXTERNAL_HOST_DIR=
# API executada diretamente, fora do Docker Compose.
BACKUP_EXTERNAL_DIR=""
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID="primary-2026"
BACKUP_SCHEDULE_ENABLED=true
BACKUP_RETENTION_COUNT=30
BACKUP_MAX_VERIFY_BYTES=536870912
BACKUP_COMMAND_TIMEOUT_MS=900000
# Execucao direta fora do Compose. No Compose, use .env.restore separado.
# Somente para prova manual em banco PostgreSQL descartavel e vazio.
RESTORE_DATABASE_URL=
RESTORE_DATABASE_EXPECTED_NAME=
RESTORE_CONFIRMATION=
RESTORE_BACKUP_SHA256=
RESTORE_BACKUP_KEY_ID=
RESTORE_MAX_BACKUP_BYTES=536870912
RESTORE_COMMAND_TIMEOUT_MS=900000
RECONCILIATION_KG_TOLERANCE=0.01
RECONCILIATION_MINUTE_TOLERANCE=0.01
LOG_LEVEL=info
