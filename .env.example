NODE_ENV=development
APP_NAME="NEXUS OPERACIONAL"
WEB_PORT=3000
API_PORT=3333
POSTGRES_USER=nexus
# Obrigatoria no Docker Compose. Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_operacional
POSTGRES_PORT=5432
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=/api
# Credenciais publicas exclusivas do preview; nunca reutilize credenciais operacionais.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@demo.nexus.local
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="NexusDemo@2026"

# Para execucao local sem Docker, informe a mesma senha do PostgreSQL na URL.
DATABASE_URL=
# Obrigatoria em producao. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL="15m"
AUTH_COOKIE_SAMESITE="lax"

INITIAL_ADMIN_EMAIL=admin@nexus.local
INITIAL_ADMIN_PASSWORD="replace-with-a-temporary-strong-password"
COMPANY_NAME="Empresa"
LEGACY_EXCEL_PATH=
IMPORT_UPLOAD_DIR="./uploads/imports"
IMPORT_MAX_UPLOAD_BYTES=26214400
BACKUP_DIR="./backups"
BACKUP_EXTERNAL_DIR=""
BACKUP_ENCRYPTION_KEY="replace-with-32-byte-base64-or-64-hex"
BACKUP_ENCRYPTION_KEY_ID="primary-2026"
BACKUP_SCHEDULE_ENABLED=true
BACKUP_RETENTION_COUNT=30
BACKUP_MAX_VERIFY_BYTES=536870912
RECONCILIATION_KG_TOLERANCE=0.01
RECONCILIATION_MINUTE_TOLERANCE=0.01
LOG_LEVEL=info
