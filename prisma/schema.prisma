model Goal {
  id                String          @id @default(uuid()) @db.Uuid
  seriesId          String          @default(uuid()) @map("series_id") @db.Uuid
  previousVersionId String?         @map("previous_version_id") @db.Uuid
  version           Int             @default(1)
  name              String
  metric            String
  sectorCode        SectorCode?     @map("sector_code")
  lineId            String?         @map("line_id") @db.Uuid
  equipmentId       String?         @map("equipment_id") @db.Uuid
  shiftId           String?         @map("shift_id") @db.Uuid
  productId         String?         @map("product_id") @db.Uuid
  scopeKey          String?         @map("scope_key")
  targetValue       Decimal         @map("target_value") @db.Decimal(14, 6)
  comparator        String          @default("<=")
  measurementUnit   String?         @map("measurement_unit")
  cadence           GoalCadence     @default(WEEKLY)
  startsOn          DateTime?       @map("starts_on") @db.Date
  endsOn            DateTime?       @map("ends_on") @db.Date
  responsibleId     String?         @map("responsible_id") @db.Uuid
  approvedBy        String?         @map("approved_by") @db.Uuid
  status            GoalStatus      @default(DRAFT)
  approvedAt        DateTime?       @map("approved_at")
  approvalReason    String?         @map("approval_reason")
  retiredAt         DateTime?       @map("retired_at")
  retiredBy         String?         @map("retired_by") @db.Uuid
  retirementReason  String?         @map("retirement_reason")
  versionReason     String?         @map("version_reason")
  legacyDueDate     DateTime?       @map("legacy_due_date") @db.Date
  legacyActive      Boolean         @default(true) @map("legacy_active")
  createdBy         String?         @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  sector            Sector?         @relation(fields: [sectorCode], references: [code], onDelete: SetNull)
  line              ProductionLine? @relation(fields: [lineId], references: [id], onDelete: Restrict)
  equipment         Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  shift             Shift?          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  responsible       User?           @relation("GoalResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  approver          User?           @relation("GoalApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  creator           User?           @relation("GoalCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  retirer           User?           @relation("GoalRetirer", fields: [retiredBy], references: [id], onDelete: Restrict)
  previousVersion   Goal?           @relation("GoalVersionHistory", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      Goal[]          @relation("GoalVersionHistory")

  @@unique([seriesId, version])
  @@index([metric, status, startsOn, endsOn])
  @@index([scopeKey, status, startsOn, endsOn])
  @@index([sectorCode, lineId, equipmentId, shiftId, productId])
  @@index([responsibleId])
  @@index([createdBy])
  @@map("goals")
}

