generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SectorCode {
  P1
  P2
}

enum WeekStatus {
  OPEN
  REVIEW
  CLOSED
  ARCHIVED
}

enum RoleCode {
  ADMIN
  MANAGER
  SUPERVISOR
  OPERATOR
  VIEWER
}

enum LossTypeCode {
  PACKAGING
  BOX
  ORGANIC
  MACHINE
  WEIGHING
  OVERWEIGHT
  OTHER
}

enum AlertStatus {
  OK
  MEDIUM
  ATTENTION
  CRITICAL
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ProductionFormula {
  BOX_WEIGHT
  PACKAGE_WEIGHT
}

enum ExportStatus {
  QUEUED
  GENERATED
  FAILED
}

enum ImportStatus {
  RECEIVED
  CLEANED
  STAGED
  IMPORTING
  PROMOTING
  IMPORTED
  IMPORTED_WITH_ERRORS
  LEGACY_CERTIFIED
  CERTIFIED
  FAILED
}

enum ImportErrorStatus {
  PENDING
  CORRECTED
  IGNORED
}

enum ImportStagingDomain {
  UNKNOWN
  PRODUCT
  PRODUCTION
  LOSS
  DOWNTIME
  DOSAGE
  HISTORY
}

enum ImportStagingClassification {
  VALID
  WARNING
  ERROR
  DUPLICATE
  REQUIRES_REVIEW
}

enum ImportReviewDecision {
  PENDING
  APPROVED
  CORRECTED
  IGNORED
  REJECTED
}

enum GoalCadence {
  DAILY
  WEEKLY
}

enum GoalStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum ProductPriceStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum CalculationRuleApprovalStatus {
  APPROVED
  RETIRED
}

enum ProductivitySource {
  INFORMED_MANUALLY
  LEGACY_UNVERIFIED
}

model User {
  id                           String                    @id @default(uuid()) @db.Uuid
  email                        String                    @unique
  name                         String
  passwordHash                 String                    @map("password_hash")
  active                       Boolean                   @default(true)
  sessionVersion               Int                       @default(1) @map("session_version")
  lastLoginAt                  DateTime?                 @map("last_login_at")
  createdAt                    DateTime                  @default(now()) @map("created_at")
  updatedAt                    DateTime                  @updatedAt @map("updated_at")
  deletedAt                    DateTime?                 @map("deleted_at")
  roles                        UserRole[]
  auditLogs                    AuditLog[]
  responsibleGoals             Goal[]                    @relation("GoalResponsible")
  approvedGoals                Goal[]                    @relation("GoalApprover")
  createdGoals                 Goal[]                    @relation("GoalCreator")
  retiredGoals                 Goal[]                    @relation("GoalRetirer")
  responsiblePrices            ProductPricePeriod[]      @relation("ProductPriceResponsible")
  approvedPrices               ProductPricePeriod[]      @relation("ProductPriceApprover")
  retiredPrices                ProductPricePeriod[]      @relation("ProductPriceRetirer")
  approvedCalculationRules     CalculationRuleApproval[] @relation("CalculationRuleApprover")
  retiredCalculationRules      CalculationRuleApproval[] @relation("CalculationRuleRetirer")
  submittedProductionEntries   ProductionEntry[]         @relation("ProductionEntrySubmitter")
  approvedProductionEntries    ProductionEntry[]         @relation("ProductionEntryApprover")
  rejectedProductionEntries    ProductionEntry[]         @relation("ProductionEntryRejector")
  createdProductionEntries     ProductionEntry[]         @relation("ProductionEntryCreator")
  updatedProductionEntries     ProductionEntry[]         @relation("ProductionEntryUpdater")
  submittedLossEntries         LossEntry[]               @relation("LossEntrySubmitter")
  approvedLossEntries          LossEntry[]               @relation("LossEntryApprover")
  rejectedLossEntries          LossEntry[]               @relation("LossEntryRejector")
  createdLossEntries           LossEntry[]               @relation("LossEntryCreator")
  updatedLossEntries           LossEntry[]               @relation("LossEntryUpdater")
  submittedDowntimeEntries     DowntimeEntry[]           @relation("DowntimeEntrySubmitter")
  approvedDowntimeEntries      DowntimeEntry[]           @relation("DowntimeEntryApprover")
  rejectedDowntimeEntries      DowntimeEntry[]           @relation("DowntimeEntryRejector")
  createdDowntimeEntries       DowntimeEntry[]           @relation("DowntimeEntryCreator")
  updatedDowntimeEntries       DowntimeEntry[]           @relation("DowntimeEntryUpdater")
  submittedDosageChecks        DosageCheck[]             @relation("DosageCheckSubmitter")
  approvedDosageChecks         DosageCheck[]             @relation("DosageCheckApprover")
  rejectedDosageChecks         DosageCheck[]             @relation("DosageCheckRejector")
  createdDosageChecks          DosageCheck[]             @relation("DosageCheckCreator")
  updatedDosageChecks          DosageCheck[]             @relation("DosageCheckUpdater")
  submittedProductivityEntries ProductivityEntry[]       @relation("ProductivityEntrySubmitter")
  approvedProductivityEntries  ProductivityEntry[]       @relation("ProductivityEntryApprover")
  rejectedProductivityEntries  ProductivityEntry[]       @relation("ProductivityEntryRejector")
  createdProductivityEntries   ProductivityEntry[]       @relation("ProductivityEntryCreator")
  updatedProductivityEntries   ProductivityEntry[]       @relation("ProductivityEntryUpdater")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Sector {
  id          String            @id @default(uuid()) @db.Uuid
  code        SectorCode        @unique
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  lines       ProductionLine[]
  products    Product[]
  entries     ProductionEntry[]
  losses      LossEntry[]
  downtimes   DowntimeEntry[]
  goals       Goal[]

  @@map("sectors")
}

model ProductionLine {
  id        String            @id @default(uuid()) @db.Uuid
  sectorId  String            @map("sector_id") @db.Uuid
  code      String
  name      String
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")
  sector    Sector            @relation(fields: [sectorId], references: [id])
  entries   ProductionEntry[]
  downtimes DowntimeEntry[]
  equipment Equipment[]
  goals     Goal[]

  @@unique([sectorId, code])
  @@map("production_lines")
}

model Equipment {
  id                  String              @id @default(uuid()) @db.Uuid
  productionLineId    String              @map("production_line_id") @db.Uuid
  code                String
  name                String
  type                String?
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  productionLine      ProductionLine      @relation(fields: [productionLineId], references: [id])
  productionEntries   ProductionEntry[]
  lossEntries         LossEntry[]
  downtimeEntries     DowntimeEntry[]
  dosageChecks        DosageCheck[]
  productivityEntries ProductivityEntry[]
  goals               Goal[]

  @@unique([productionLineId, code])
  @@index([active, deletedAt])
  @@map("equipment")
}

model Shift {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique
  name                String
  startsAt            DateTime            @map("starts_at") @db.Time(0)
  endsAt              DateTime            @map("ends_at") @db.Time(0)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  productionEntries   ProductionEntry[]
  lossEntries         LossEntry[]
  downtimeEntries     DowntimeEntry[]
  dosageChecks        DosageCheck[]
  productivityEntries ProductivityEntry[]
  goals               Goal[]

  @@index([active, deletedAt])
  @@map("shifts")
}

model Product {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique
  name               String
  defaultSectorId    String               @map("default_sector_id") @db.Uuid
  unit               String               @default("kg")
  pricePerKg         Decimal              @default(0) @map("price_per_kg") @db.Decimal(14, 4)
  filmCostPerKg      Decimal              @default(0) @map("film_cost_per_kg") @db.Decimal(14, 4)
  packageFilmWeightG Decimal              @default(0) @map("package_film_weight_g") @db.Decimal(12, 3)
  active             Boolean              @default(true)
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")
  createdBy          String?              @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  defaultSector      Sector               @relation(fields: [defaultSectorId], references: [id])
  weightConfig       ProductWeightConfig?
  orders             ProductionOrder[]
  entries            ProductionEntry[]
  losses             LossEntry[]
  pricePeriods       ProductPricePeriod[]
  dosageChecks       DosageCheck[]
  goals              Goal[]

  @@index([defaultSectorId])
  @@map("products")
}

model ProductPricePeriod {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  startsOn          DateTime           @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  pricePerKg        Decimal            @map("price_per_kg") @db.Decimal(14, 4)
  filmCostPerKg     Decimal            @default(0) @map("film_cost_per_kg") @db.Decimal(14, 4)
  currency          String?            @db.VarChar(3)
  origin            String?
  observation       String?
  responsibleBy     String?            @map("responsible_by") @db.Uuid
  approvedBy        String?            @map("approved_by") @db.Uuid
  approvedAt        DateTime?          @map("approved_at")
  approvalReason    String?            @map("approval_reason")
  retiredBy         String?            @map("retired_by") @db.Uuid
  retiredAt         DateTime?          @map("retired_at")
  retirementReason  String?            @map("retirement_reason")
  status            ProductPriceStatus @default(DRAFT)
  version           Int                @default(1)
  recordVersion     Int                @default(1) @map("record_version")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  product           Product            @relation(fields: [productId], references: [id])
  responsible       User?              @relation("ProductPriceResponsible", fields: [responsibleBy], references: [id], onDelete: Restrict)
  approver          User?              @relation("ProductPriceApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  retirer           User?              @relation("ProductPriceRetirer", fields: [retiredBy], references: [id], onDelete: Restrict)
  productionEntries ProductionEntry[]  @relation("ProductionEntryPricePeriod")
  lossEntries       LossEntry[]        @relation("LossEntryPricePeriod")

  @@unique([productId, version])
  @@index([productId, status, startsOn, endsOn])
  @@index([responsibleBy])
  @@map("product_price_periods")
}

model ProductWeightConfig {
  id                         String            @id @default(uuid()) @db.Uuid
  productId                  String            @unique @map("product_id") @db.Uuid
  packageWeightKg            Decimal           @map("package_weight_kg") @db.Decimal(12, 3)
  boxWeightKg                Decimal           @map("box_weight_kg") @db.Decimal(12, 3)
  packagesPerBox             Int               @map("packages_per_box")
  massWeightKg               Decimal           @map("mass_weight_kg") @db.Decimal(12, 3)
  targetPackageWeightG       Decimal           @map("target_package_weight_g") @db.Decimal(12, 3)
  overweightTolerancePercent Decimal           @default(0.02) @map("overweight_tolerance_percent") @db.Decimal(8, 6)
  formula                    ProductionFormula @default(BOX_WEIGHT)
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  product                    Product           @relation(fields: [productId], references: [id])

  @@map("product_weight_configs")
}

model WeeklyPeriod {
  id                  String              @id @default(uuid()) @db.Uuid
  year                Int
  month               Int
  weekNumber          Int                 @map("week_number")
  label               String
  startsOn            DateTime            @map("starts_on") @db.Date
  endsOn              DateTime            @map("ends_on") @db.Date
  status              WeekStatus          @default(OPEN)
  closedAt            DateTime?           @map("closed_at")
  archivedAt          DateTime?           @map("archived_at")
  snapshotData        Json?               @map("snapshot_data")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  entries             ProductionEntry[]
  orders              ProductionOrder[]
  losses              LossEntry[]
  downtimes           DowntimeEntry[]
  productivityEntries ProductivityEntry[]
  snapshots           DashboardSnapshot[]
  dosageChecks        DosageCheck[]

  @@unique([year, month, weekNumber])
  @@index([status])
  @@map("weekly_periods")
}

model ProductionOrder {
  id          String            @id @default(uuid()) @db.Uuid
  weekId      String            @map("week_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  sectorCode  SectorCode        @map("sector_code")
  orderNumber String            @map("order_number")
  status      String            @default("OPEN")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  week        WeeklyPeriod      @relation(fields: [weekId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  entries     ProductionEntry[]
  losses      LossEntry[]

  @@unique([weekId, orderNumber, productId])
  @@map("production_orders")
}

model ProductionEntry {
  id                      String              @id @default(uuid()) @db.Uuid
  weekId                  String              @map("week_id") @db.Uuid
  sectorId                String              @map("sector_id") @db.Uuid
  lineId                  String?             @map("line_id") @db.Uuid
  equipmentId             String?             @map("equipment_id") @db.Uuid
  shiftId                 String?             @map("shift_id") @db.Uuid
  importBatchId           String?             @map("import_batch_id") @db.Uuid
  productId               String              @map("product_id") @db.Uuid
  pricePeriodId           String?             @map("price_period_id") @db.Uuid
  priceVersion            Int?                @map("price_version")
  priceOrigin             String?             @map("price_origin")
  priceCurrency           String?             @map("price_currency") @db.VarChar(3)
  productionOrderId       String?             @map("production_order_id") @db.Uuid
  date                    DateTime            @db.Date
  productionOrder         String              @map("production_order")
  plannedBatches          Decimal             @map("planned_batches") @db.Decimal(12, 3)
  realizedBatches         Decimal             @map("realized_batches") @db.Decimal(12, 3)
  usedReworkKg            Decimal             @default(0) @map("used_rework_kg") @db.Decimal(12, 3)
  packedBoxes             Decimal             @map("packed_boxes") @db.Decimal(12, 3)
  producedKg              Decimal             @map("produced_kg") @db.Decimal(14, 3)
  weighingLossKg          Decimal             @default(0) @map("weighing_loss_kg") @db.Decimal(12, 3)
  generatedReworkKg       Decimal             @default(0) @map("generated_rework_kg") @db.Decimal(12, 3)
  expectedYieldKg         Decimal             @map("expected_yield_kg") @db.Decimal(14, 3)
  realYieldPercent        Decimal             @map("real_yield_percent") @db.Decimal(10, 6)
  massWeightKg            Decimal             @map("mass_weight_kg") @db.Decimal(12, 3)
  boxWeightKg             Decimal             @map("box_weight_kg") @db.Decimal(12, 3)
  targetPackageWeightG    Decimal             @map("target_package_weight_g") @db.Decimal(12, 3)
  averagePackageWeightG   Decimal?            @map("average_package_weight_g") @db.Decimal(12, 3)
  overweightGPerPackage   Decimal             @map("overweight_g_per_package") @db.Decimal(12, 3)
  overweightTotalKg       Decimal             @map("overweight_total_kg") @db.Decimal(14, 3)
  overweightPercent       Decimal             @map("overweight_percent") @db.Decimal(10, 6)
  unitPricePerKg          Decimal             @default(0) @map("unit_price_per_kg") @db.Decimal(14, 4)
  productionCost          Decimal             @default(0) @map("production_cost") @db.Decimal(14, 2)
  lossesCost              Decimal             @default(0) @map("losses_cost") @db.Decimal(14, 2)
  overweightCost          Decimal             @default(0) @map("overweight_cost") @db.Decimal(14, 2)
  calculationRuleVersions Json                @default("{}") @map("calculation_rule_versions")
  status                  AlertStatus         @default(OK)
  workflowStatus          WorkflowStatus      @default(DRAFT) @map("workflow_status")
  version                 Int                 @default(1)
  submittedAt             DateTime?           @map("submitted_at")
  submittedBy             String?             @map("submitted_by") @db.Uuid
  submissionReason        String?             @map("submission_reason")
  approvedAt              DateTime?           @map("approved_at")
  approvedBy              String?             @map("approved_by") @db.Uuid
  approvalReason          String?             @map("approval_reason")
  rejectedAt              DateTime?           @map("rejected_at")
  rejectedBy              String?             @map("rejected_by") @db.Uuid
  rejectionReason         String?             @map("rejection_reason")
  notes                   String?
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  deletedAt               DateTime?           @map("deleted_at")
  createdBy               String?             @map("created_by") @db.Uuid
  updatedBy               String?             @map("updated_by") @db.Uuid
  week                    WeeklyPeriod        @relation(fields: [weekId], references: [id])
  sector                  Sector              @relation(fields: [sectorId], references: [id])
  line                    ProductionLine?     @relation(fields: [lineId], references: [id])
  equipment               Equipment?          @relation(fields: [equipmentId], references: [id])
  shift                   Shift?              @relation(fields: [shiftId], references: [id])
  importBatch             ImportBatch?        @relation(fields: [importBatchId], references: [id])
  product                 Product             @relation(fields: [productId], references: [id])
  pricePeriod             ProductPricePeriod? @relation("ProductionEntryPricePeriod", fields: [pricePeriodId], references: [id], onDelete: Restrict)
  order                   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  submitter               User?               @relation("ProductionEntrySubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver                User?               @relation("ProductionEntryApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  rejector                User?               @relation("ProductionEntryRejector", fields: [rejectedBy], references: [id], onDelete: Restrict)
  creator                 User?               @relation("ProductionEntryCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater                 User?               @relation("ProductionEntryUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([weekId, sectorId, date])
  @@index([productId])
  @@index([pricePeriodId])
  @@index([productionOrder])
  @@index([equipmentId, shiftId])
  @@index([importBatchId])
  @@index([weekId, workflowStatus])
  @@map("production_entries")
}

model LossType {
  id            String       @id @default(uuid()) @db.Uuid
  code          LossTypeCode @unique
  name          String
  defaultGoalKg Decimal?     @map("default_goal_kg") @db.Decimal(12, 3)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  entries       LossEntry[]

  @@map("loss_types")
}

model LossEntry {
  id                      String              @id @default(uuid()) @db.Uuid
  weekId                  String              @map("week_id") @db.Uuid
  date                    DateTime            @db.Date
  sectorId                String?             @map("sector_id") @db.Uuid
  productId               String?             @map("product_id") @db.Uuid
  pricePeriodId           String?             @map("price_period_id") @db.Uuid
  priceVersion            Int?                @map("price_version")
  priceOrigin             String?             @map("price_origin")
  priceCurrency           String?             @map("price_currency") @db.VarChar(3)
  productionOrderId       String?             @map("production_order_id") @db.Uuid
  equipmentId             String?             @map("equipment_id") @db.Uuid
  shiftId                 String?             @map("shift_id") @db.Uuid
  importBatchId           String?             @map("import_batch_id") @db.Uuid
  lossTypeId              String              @map("loss_type_id") @db.Uuid
  quantityKg              Decimal             @map("quantity_kg") @db.Decimal(12, 3)
  filmShift1Kg            Decimal?            @map("film_shift_1_kg") @db.Decimal(12, 3)
  filmShift2Kg            Decimal?            @map("film_shift_2_kg") @db.Decimal(12, 3)
  boxLossUnits            Decimal?            @map("box_loss_units") @db.Decimal(12, 3)
  boxLossShift1Units      Decimal?            @map("box_loss_shift_1_units") @db.Decimal(12, 3)
  boxLossShift2Units      Decimal?            @map("box_loss_shift_2_units") @db.Decimal(12, 3)
  unitCost                Decimal             @default(0) @map("unit_cost") @db.Decimal(14, 4)
  lossCost                Decimal             @default(0) @map("loss_cost") @db.Decimal(14, 2)
  packedBoxes             Decimal             @default(0) @map("packed_boxes") @db.Decimal(12, 3)
  packageFilmWeightG      Decimal             @default(0) @map("package_film_weight_g") @db.Decimal(12, 3)
  filmCostPerKg           Decimal             @default(0) @map("film_cost_per_kg") @db.Decimal(14, 4)
  filmUsedKg              Decimal             @default(0) @map("film_used_kg") @db.Decimal(14, 3)
  filmUsedValue           Decimal             @default(0) @map("film_used_value") @db.Decimal(14, 2)
  financialResult         Decimal             @default(0) @map("financial_result") @db.Decimal(14, 2)
  calculationRuleVersions Json                @default("{}") @map("calculation_rule_versions")
  workflowStatus          WorkflowStatus      @default(DRAFT) @map("workflow_status")
  version                 Int                 @default(1)
  submittedAt             DateTime?           @map("submitted_at")
  submittedBy             String?             @map("submitted_by") @db.Uuid
  submissionReason        String?             @map("submission_reason")
  approvedAt              DateTime?           @map("approved_at")
  approvedBy              String?             @map("approved_by") @db.Uuid
  approvalReason          String?             @map("approval_reason")
  rejectedAt              DateTime?           @map("rejected_at")
  rejectedBy              String?             @map("rejected_by") @db.Uuid
  rejectionReason         String?             @map("rejection_reason")
  reason                  String?
  notes                   String?
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  deletedAt               DateTime?           @map("deleted_at")
  createdBy               String?             @map("created_by") @db.Uuid
  updatedBy               String?             @map("updated_by") @db.Uuid
  week                    WeeklyPeriod        @relation(fields: [weekId], references: [id])
  sector                  Sector?             @relation(fields: [sectorId], references: [id])
  product                 Product?            @relation(fields: [productId], references: [id])
  pricePeriod             ProductPricePeriod? @relation("LossEntryPricePeriod", fields: [pricePeriodId], references: [id], onDelete: Restrict)
  productionOrder         ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  equipment               Equipment?          @relation(fields: [equipmentId], references: [id])
  shift                   Shift?              @relation(fields: [shiftId], references: [id])
  importBatch             ImportBatch?        @relation(fields: [importBatchId], references: [id])
  lossType                LossType            @relation(fields: [lossTypeId], references: [id])
  submitter               User?               @relation("LossEntrySubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver                User?               @relation("LossEntryApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  rejector                User?               @relation("LossEntryRejector", fields: [rejectedBy], references: [id], onDelete: Restrict)
  creator                 User?               @relation("LossEntryCreator", fields: [createdBy], references: [id], onDelete: Restrict)
